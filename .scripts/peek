import subprocess
import sys

# gtk4-layer-shell has to be loaded before libwayland-client or it cannot
# intercept the surface, and a language binding loads GTK too late for that.
# Re-exec once with it preloaded; without this the prompt silently falls back to
# an ordinary window and SwayFX rounds its corners. The keybinding sets
# LD_PRELOAD itself, so the common path skips this and saves an interpreter
# start; launching peek by hand from a shell still gets the re-exec.
_LAYER_SO = "/usr/lib/libgtk4-layer-shell.so"
if (_LAYER_SO not in os.environ.get("LD_PRELOAD", "")
        and not os.environ.get("PEEK_PRELOADED")
        and os.path.exists(_LAYER_SO)):
    os.environ["PEEK_PRELOADED"] = "1"
    os.environ["LD_PRELOAD"] = _LAYER_SO
    os.execv(sys.executable, [sys.executable, os.path.abspath(__file__), *sys.argv[1:]])

APP_ID = "dev.milo.peek"
# The prompt is a layer-shell surface, not an ordinary window. That is the only
# way SwayFX can give one surface square corners: corner_radius on a window is a
# global setting, while layer_effects <namespace> is genuinely per-surface.
LAYER_NAMESPACE = "peek"
IMAGE_EXT = {".png", ".jpg", ".jpeg", ".webp", ".gif", ".bmp", ".svg", ".avif", ".tif", ".tiff", ".ico"}
VIDEO_EXT = {".mp4", ".webm", ".mkv", ".mov", ".avi", ".m4v", ".ogv",
             ".mpg", ".mpeg", ".wmv", ".flv", ".ts", ".m2ts", ".3gp"}
# .ogg lives here rather than with video: in the wild it is nearly always
# Vorbis audio. Theora video keeps .ogv.
AUDIO_EXT = {".mp3", ".m4a", ".aac", ".flac", ".wav", ".ogg", ".oga", ".opus",
             ".wma", ".aiff", ".aif", ".alac", ".mka", ".ape"}
MEDIA_EXT = IMAGE_EXT | VIDEO_EXT | AUDIO_EXT
GAP = 16

# Held open for the life of the prompt so a second $mod+i is a no-op instead of
# a second window. Module-level so it is never garbage collected.
_LOCK_FD = None


def claim_prompt_lock() -> bool:
    """One prompt at a time.

    Pressing the keybinding again because the first press seemed to do nothing
    used to open a second prompt. Take the lock before GTK is even imported, so
    the duplicate press costs a few milliseconds and dies quietly.
    """
    global _LOCK_FD
    run_dir = os.environ.get("XDG_RUNTIME_DIR") or "/tmp"
    try:
        fd = os.open(os.path.join(run_dir, "peek-prompt.lock"), os.O_CREAT | os.O_RDWR, 0o600)
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return False
    _LOCK_FD = fd
    return True


_ARGV = sys.argv[1:]
_IS_PROMPT = not _ARGV or _ARGV[0] in ("--paste",)
if _IS_PROMPT and not claim_prompt_lock():
    sys.exit(0)

