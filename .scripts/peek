#!/usr/bin/env python3
"""peek — a centred prompt that shows an image, video or audio file the moment you paste its path.

    peek                       open the prompt
    peek --paste TEXT          open it with the entry prefilled (for testing)

Paste an image instead of a path and it runs the other way: the picture is
written to /tmp, opened, and its location left in the entry and on the clipboard.
    peek --view PATH           open one picture or video as a floating window
    peek --view PATH -s I -n N one of N windows, placed in slot I of a grid
    peek --audio PATH...       open one player for every audio file at once

No Enter: the entry resolves on every keystroke, so a pasted path shows itself.
One path grows the prompt into the picture; a video starts playing. Several
paths open one window each, laid out on a grid so none covers another.

Audio is the exception: every audio file pasted at once lands in a single
player, because two songs at the same time is noise. Move the cursor with the
arrows or j/k and press space to play, space again to pause.

Escape closes every peek window at once, prompt, pictures, videos and players
alike.
"""
import fcntl
import itertools
import math
import os
import re
import shlex
